# Environment variable-ийн жагсаалт. Жинхэнэ утгыг энд БИЧИХГҮЙ.
# Утгыг Vercel-ийн Settings > Environment Variables-д Secret төрлөөр нэмнэ.

# Apps Script Web App-ын /exec хаяг
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Apps Script-ийн Script Properties дахь SHARED_SECRET-тэй ижил утга
SHEETS_SECRET=YOUR_SHARED_SECRET
