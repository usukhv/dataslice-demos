# Төслийн бүх environment variable-ийн жагсаалт. Жинхэнэ утгыг энд БИЧИХГҮЙ.
# Утгыг Vercel-ийн Settings > Environment Variables-д нэмнэ. vercel dev тэдгээрийг өөрөө татна.
# Компьютер дээрээ хуулбар хэрэгтэй бол: vercel env pull .env.local (.env.local-ийг commit хийхгүй).

# Secret: Apps Script Web App-ын /exec хаяг (11-р хичээл)
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Secret: Apps Script-ийн SHARED_SECRET-тэй ижил утга
SHEETS_SECRET=YOUR_SHARED_SECRET

# Config: demo эсвэл qpay (13-р хичээл)
PAYMENT_MODE=demo
# Config: сайтын бүтэн хаяг, QPay callback-д ашиглана (15-р хичээл)
SITE_URL=https://YOUR_PROJECT.vercel.app

# Зөвхөн PAYMENT_MODE=qpay үед
# Config: sandbox https://merchant-sandbox.qpay.mn, production https://merchant.qpay.mn
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn
# Secret: QPay-ээс авсан эрх
QPAY_CLIENT_ID=YOUR_QPAY_CLIENT_ID
QPAY_CLIENT_SECRET=YOUR_QPAY_CLIENT_SECRET
QPAY_INVOICE_CODE=YOUR_QPAY_INVOICE_CODE
