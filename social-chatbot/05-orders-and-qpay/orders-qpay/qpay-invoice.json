              "value": "1001",
              "type": "string"
            },
            {
              "id": "173f2740-97e1-5ff6-b0ba-9d699426e8df",
              "name": "chat_id",
              "value": "YOUR_TEST_CHAT_ID",
              "type": "string"
            },
            {
              "id": "4cfffae9-7a58-503e-a8ae-38ba7af39ffa",
              "name": "total",
              "value": 45000,
              "type": "number"
            },
            {
              "id": "4c87c961-4c87-5dbb-af7a-67cc72f1a4e6",
              "name": "description",
              "value": "Order 1001",
              "type": "string"
            }
          ]
        },
        "options": {}
