      "id": "74fab06a-d8e2-597e-9ec0-82ac5beb70d2",
      "name": "Order",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.qpay_base }}/v2/auth/token",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "options": {}
      },
      "id": "61487f7a-89f7-571d-a19f-83971caed046",
      "name": "QPay token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.qpay_base }}/v2/invoice",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('QPay token').item.json.access_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"invoice_code\": \"{{ $('Config').item.json.invoice_code }}\",\n  \"sender_invoice_no\": \"{{ $('Order').item.json.order_id }}\",\n  \"invoice_receiver_code\": \"{{ $('Order').item.json.chat_id }}\",\n  \"invoice_description\": \"{{ $('Order').item.json.description }}\",\n  \"amount\": {{ $('Order').item.json.total }},\n  \"callback_url\": \"{{ $('Config').item.json.callback_url }}\"\n}",
        "options": {}
      },
      "id": "6856150b-5600-53af-b534-99682fc0b082",
      "name": "Create invoice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Order').item.json.chat_id }}",
        "text": "=Захиалга #{{ $('Order').item.json.order_id }}\nТөлөх дүн: {{ $('Order').item.json.total }}₮\nТөлбөрийн холбоос: {{ $('Create invoice').item.json.qPay_shortUrl }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "492e55e3-add7-5cb4-a8fb-a42f8cf33179",
