        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"object_type\": \"INVOICE\",\n  \"object_id\": \"{{ $('Create invoice').item.json.invoice_id }}\",\n  \"offset\": { \"page_number\": 1, \"page_limit\": 100 }\n}",
        "options": {}
      },
      "id": "3273e13a-d7e4-5620-a943-74ee92b45533",
      "name": "Check payment",
